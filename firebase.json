{
  "hosting": {
    "site": "trovalim",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".github",
      ".git",
      "**/.*",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "storage.rules",
      "_*.js"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
