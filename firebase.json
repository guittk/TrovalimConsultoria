{
  "hosting": {
    "site": "trovalim",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".github",
      ".git",
      "**/.*",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "storage.rules",
      "_*.js"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
