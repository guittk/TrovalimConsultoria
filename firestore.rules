rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Owner: acesso total, inclusive gerenciar contas (criar/editar/excluir/definir role)
    function isOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    // Staff (owner ou manager): acesso total a projetos e clientes, mas
    // apenas o owner pode escrever em contas (ver regra de /users abaixo)
    function isStaff() {
      return isSignedIn() && myRole() in ['owner', 'manager'];
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Users: staff lê todos; usuário lê o próprio doc (por UID) ou um doc
    // cujo campo email bata com o e-mail autenticado (fallback para docs
    // criados manualmente com ID diferente do UID).
    // Criar/excluir conta e mudar role: só owner.
    // Editar dados do próprio cliente (nome, branding): staff também pode,
    // desde que não mude o campo role.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.email == request.auth.token.email) ||
        isStaff()
      );
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isStaff() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
    }

    // Projetos: staff (owner + manager) tem acesso total
    match /projects/{projectId} {
      allow read, write: if isStaff();
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Mensagens: dono e staff leem/escrevem; só staff deleta
      match /messages/{msgId} {
        allow read, create: if isStaff() || isProjectOwner(projectId);
        allow update, delete: if isStaff();
      }

      // Arquivos (metadados): dono e staff leem/criam; só staff deleta
      match /files/{fileId} {
        allow read, create: if isStaff() || isProjectOwner(projectId);
        allow delete: if isStaff();
      }
    }
  }
}
