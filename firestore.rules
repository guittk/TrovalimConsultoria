rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Owner: acesso total, inclusive gerenciar contas (criar/editar/excluir/definir role)
    function isOwner() {
      return isSignedIn() && myAccount().role == 'owner';
    }

    function isManager() {
      return isSignedIn() && myAccount().role == 'manager';
    }

    // Staff (owner ou manager): acesso a projetos e clientes, mas apenas o
    // owner pode escrever em contas (ver regra de /users abaixo)
    function isStaff() {
      return isOwner() || isManager();
    }

    // Managers podem ter a visão restrita a um subconjunto de projetos
    // (campo projectAccess na própria conta). Sem o campo, ou null, = todos.
    function managerCanAccessProject(projectId) {
      let acc = myAccount();
      return !('projectAccess' in acc) || acc.projectAccess == null || (projectId in acc.projectAccess);
    }

    function canAccessProject(projectId) {
      return isOwner() || (isManager() && managerCanAccessProject(projectId));
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Users: staff lê todos; usuário lê o próprio doc (por UID) ou um doc
    // cujo campo email bata com o e-mail autenticado (fallback para docs
    // criados manualmente com ID diferente do UID).
    // Criar/excluir conta, mudar role ou projectAccess: só owner.
    // Editar dados do próprio cliente (nome, branding): staff também pode.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.email == request.auth.token.email) ||
        isStaff()
      );
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isStaff() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'projectAccess'])
      );
    }

    // Projetos: staff tem acesso, managers restritos ao projectAccess se definido
    match /projects/{projectId} {
      allow read, write: if canAccessProject(projectId);
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Mensagens: dono e staff (com acesso ao projeto) leem/escrevem
      match /messages/{msgId} {
        allow read, create: if canAccessProject(projectId) || isProjectOwner(projectId);
        allow update, delete: if canAccessProject(projectId);
      }

      // Arquivos (metadados): dono e staff (com acesso ao projeto) leem/criam
      match /files/{fileId} {
        allow read, create: if canAccessProject(projectId) || isProjectOwner(projectId);
        allow delete: if canAccessProject(projectId);
      }
    }

    // Configurações da plataforma (ex: cor). Qualquer usuário autenticado lê
    // (afeta como o portal do cliente renderiza), só owner escreve.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
