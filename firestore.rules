rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Uso de .get(key, default) para não estourar erro em contas sem o
    // campo companyId (a maioria: staff e empresas-cliente principais).
    function myCompanyId() {
      return isSignedIn() ? myAccount().get('companyId', null) : null;
    }

    // Owner: acesso total, inclusive gerenciar contas (criar/editar/excluir/definir role)
    function isOwner() {
      return isSignedIn() && myAccount().role == 'owner';
    }

    function isManager() {
      return isSignedIn() && myAccount().role == 'manager';
    }

    // Staff (owner ou manager): acesso a projetos e clientes, mas apenas o
    // owner pode escrever em contas (ver regra de /users abaixo)
    function isStaff() {
      return isOwner() || isManager();
    }

    // O próprio mentorado, dono do PDI em /mentorships/{uid}.
    function isMentee(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Managers podem ter a visão restrita a um subconjunto de projetos
    // (campo projectAccess na própria conta). Sem o campo, ou null, = todos.
    function managerCanAccessProject(projectId) {
      let acc = myAccount();
      return !('projectAccess' in acc) || acc.projectAccess == null || (projectId in acc.projectAccess);
    }

    function canAccessProject(projectId) {
      return isOwner() || (isManager() && managerCanAccessProject(projectId));
    }

    // Espelha managerCanAccessProject, mas para empresas: companyAccess é
    // calculado a partir do ownerId dos projetos em projectAccess ao salvar
    // a restrição (ver admin-accounts.component.ts). Sem o campo, ou null,
    // = todas as empresas.
    function managerCanAccessCompany(companyId) {
      let acc = myAccount();
      return !('companyAccess' in acc) || acc.companyAccess == null || (companyId in acc.companyAccess);
    }

    // Um cliente pode ser o dono direto do projeto (ownerId == seu uid) ou um
    // colaborador de uma empresa-cliente (seu companyId == ownerId do projeto).
    // Projetos marcados como "hidden" ficam invisíveis para o cliente, mesmo
    // sendo o dono.
    function isProjectOwner(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isSignedIn() && !project.get('hidden', false) &&
        (project.ownerId == request.auth.uid || project.ownerId == myCompanyId());
    }

    // Users: owner lê todos; manager lê contas staff (owner/manager) e
    // contas client cuja companyId esteja em companyAccess (sem
    // companyAccess = todas); usuário lê o próprio doc (por UID) ou um doc
    // cujo campo email bata com o e-mail autenticado (fallback para docs
    // criados manualmente com ID diferente do UID).
    // Criar/excluir conta, mudar role/projectAccess/companyAccess: só owner.
    // Editar dados do próprio cliente (nome, branding): staff também pode.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.email == request.auth.token.email) ||
        isOwner() ||
        (isManager() && (
          resource.data.get('role', '') in ['owner', 'manager'] ||
          managerCanAccessCompany(resource.data.get('companyId', null))
        ))
      );
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        isStaff() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'projectAccess', 'companyAccess', 'hiddenTabs'])
      );
    }

    // Empresas: owner tem acesso total; manager restrito a companyAccess se
    // definido; um colaborador (companyId aponta pra cá) lê a própria
    // empresa e pode atualizar só o contador de uso de armazenamento ao
    // subir/excluir um arquivo. Criar/excluir: só owner (mesma regra da
    // tela "Nova Empresa" e da exclusão em Empresas).
    match /empresas/{empresaId} {
      allow read: if isSignedIn() && (
        isOwner() || (isManager() && managerCanAccessCompany(empresaId)) || myCompanyId() == empresaId
      );
      allow create, delete: if isOwner();
      allow update: if isStaff() || (
        isSignedIn() && myCompanyId() == empresaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storageUsageBytes'])
      );
    }

    // Projetos: staff tem acesso, managers restritos ao projectAccess se definido
    match /projects/{projectId} {
      allow read, write: if canAccessProject(projectId);
      allow read: if isSignedIn() && !resource.data.get('hidden', false) && (
        resource.data.ownerId == request.auth.uid || resource.data.ownerId == myCompanyId()
      );

      // Mensagens: dono e staff (com acesso ao projeto) leem/escrevem
      match /messages/{msgId} {
        allow read, create: if canAccessProject(projectId) || isProjectOwner(projectId);
        allow update, delete: if canAccessProject(projectId);
      }

      // Arquivos (metadados): dono e staff (com acesso ao projeto) leem/criam.
      // Exclusão: staff exclui qualquer arquivo; o cliente dono do projeto só
      // pode excluir os arquivos que ele mesmo enviou (uploadedByRole == 'client').
      match /files/{fileId} {
        allow read, create: if canAccessProject(projectId) || isProjectOwner(projectId);
        allow delete: if canAccessProject(projectId) ||
          (isProjectOwner(projectId) && resource.data.uploadedByRole == 'client');
      }

      // Notas internas: só a equipe (nunca o cliente dono do projeto) lê/escreve.
      match /internal/{docId} {
        allow read, write: if canAccessProject(projectId);
      }
    }

    // Plano de Desenvolvimento Individual: id do documento é o uid do
    // mentorado. Conteúdo do plano (objetivo, competências) só a equipe
    // escreve — o mentorado lê o que a equipe montou, nunca reescreve as
    // próprias metas.
    match /mentorships/{uid} {
      allow read: if isStaff() || isMentee(uid);
      allow write: if isStaff();

      // Ações: a equipe define o quê/como/prazo; o mentorado só marca
      // status e anexa a própria evidência — nunca reescreve o enunciado
      // da ação. hasOnly() garante isso na regra, não só na tela.
      match /actions/{actionId} {
        allow read: if isStaff() || isMentee(uid);
        allow create, delete: if isStaff();
        allow update: if isStaff() || (
          isMentee(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'evidenciaUrl', 'evidenciaNome'])
        );
      }

      // Notas da consultora sobre os encontros: nunca o mentorado, mesmo
      // sendo o dono do PDI — mesma régua de /projects/{id}/internal.
      match /internal/{docId} {
        allow read, write: if isStaff();
      }

      // Reavaliação de competências: fotografia gravada pela equipe, mas o
      // mentorado PODE ver o próprio histórico (diferente das notas
      // internas) — é o que dá sensação de evolução.
      match /reassessments/{reassessmentId} {
        allow read: if isStaff() || isMentee(uid);
        allow write: if isStaff();
      }

      // Mensagens entre a equipe e o mentorado.
      match /messages/{msgId} {
        allow read, create: if isStaff() || isMentee(uid);
        allow update, delete: if isStaff();
      }
    }

    // Consultoria de currículo/LinkedIn (o "lado pessoa"). Mesmo padrão de
    // /mentorships/{uid} — indexado pelo uid, isMentee(uid) reutilizado
    // (é só "este uid sou eu mesmo", serve pra qualquer papel não-staff).
    match /careerTracks/{uid} {
      allow read: if isStaff() || isMentee(uid);
      allow create, delete: if isStaff();
      // linkedinChecklist é ferramenta de autoacompanhamento — a PRÓPRIA
      // pessoa marca os itens. Estágio/objetivo continuam só da equipe.
      allow update: if isStaff() || (
        isMentee(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedinChecklist'])
      );

      // Versões do currículo: a equipe sobe o arquivo, a pessoa só lê.
      match /versions/{versionId} {
        allow read: if isStaff() || isMentee(uid);
        allow write: if isStaff();
      }
    }

    // Configurações da plataforma (ex: cor, limites de arquivo/armazenamento).
    // Qualquer usuário autenticado lê, só owner escreve.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Contador de uso total de armazenamento: qualquer usuário autenticado
    // pode incrementar/decrementar ao subir ou excluir um arquivo (não
    // contém dados sensíveis, só um agregado numérico).
    match /settings/storageUsage {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Chave da OpenAI: diferente da chave VAPID (pública), esta é SEGREDO.
    // A regra genérica de /settings/{docId} acima libera leitura pra
    // qualquer usuário autenticado — inclusive uma conta client no portal —
    // então este doc precisa de uma regra própria, mais restrita, ou a
    // chave vazaria pra fora da equipe pelo próprio SDK do navegador. Só a
    // Cloud Function usa a chave de verdade (Admin SDK, ignora esta regra).
    match /settings/openai {
      allow read, write: if isOwner();
    }

    // Envios do formulário de contato do site público: qualquer visitante
    // (sem login) pode criar; leitura só para a equipe (ainda sem tela na
    // plataforma para consumir isso, mas os dados já ficam guardados).
    match /contactSubmissions/{id} {
      allow create: if true;
      allow read, delete: if isStaff();
    }

    // Tarefas internas do quadro Kanban: só a equipe (owner/manager) vê ou
    // mexe — nunca a empresa-cliente, mesmo que a tarefa cite um projeto dela.
    match /tasks/{taskId} {
      allow read, write: if isStaff();
    }

    // Compromissos do Calendário interno: mesma régua do Kanban — só a
    // equipe, nunca a empresa-cliente. Prazos (etapa de projeto, tarefa)
    // aparecem na mesma tela por leitura de /projects e /tasks, não como
    // documentos aqui.
    match /calendarEvents/{eventId} {
      allow read, write: if isStaff();
    }

    // Prospecção (funil de leads): só a equipe — é informação comercial
    // interna, nunca visível pra empresa-cliente nem antes nem depois de
    // virar projeto.
    match /leads/{leadId} {
      allow read, write: if isStaff();
    }

    // Vagas de recrutamento (pertencem a um projeto) e candidatos (banco de
    // talentos, coleção própria — candidato reprovado numa vaga continua
    // existindo pra outra). Currículo e parecer de entrevista são dado
    // pessoal de terceiro (LGPD), o titular não é o cliente da Trovalim —
    // só a equipe vê tudo. A empresa-cliente só enxerga um candidato
    // quando a equipe marca `clientVisible == true`, e só dentro do
    // PRÓPRIO projeto (`Candidate.projectId`, denormalizado da vaga na
    // criação — um hop só, candidato→projeto, em vez de dois
    // candidato→vaga→projeto). Testado no Emulator Suite antes de valer
    // pra produção.
    match /vagas/{vagaId} {
      allow read, write: if isStaff();
    }
    // IMPORTANTE: leitura de documento no Firestore é tudo-ou-nada — não dá
    // pra liberar só nome/estágio/LinkedIn e esconder currículo/notas/
    // contato no MESMO get()/list(). Por isso `read` continua staff-only
    // mesmo com clientVisible=true: o que a empresa-cliente vê vem da
    // Cloud Function `listVisibleCandidates` (Admin SDK, projeta só os
    // campos seguros antes de devolver). Só a ESCRITA do parecer é direta
    // pelo cliente — updateDoc() não exige ler o documento antes, e a
    // regra restringe por campo com affectedKeys().hasOnly(...).
    match /candidates/{candidateId} {
      allow read, create, delete: if isStaff();
      allow update: if isStaff() || (
        resource.data.get('clientVisible', false) == true &&
        resource.data.projectId != null &&
        isProjectOwner(resource.data.projectId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientFeedback'])
      );
    }

    // Registro de aparelho pra Push (FCM): o id do doc é o próprio token.
    // Cada conta só grava/apaga o PRÓPRIO registro; leitura é só pras
    // Cloud Functions, via Admin SDK, que ignora estas regras.
    match /pushTokens/{token} {
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
