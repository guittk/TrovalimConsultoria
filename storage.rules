rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Arquivos de projetos (consultora e cliente)
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAdmin() || isProjectOwner(projectId);
      allow write: if isAdmin() || isProjectOwner(projectId);
      allow delete: if isAdmin();
    }

    // Logos de branding
    match /branding/{projectId}/{allPaths=**} {
      allow read: if isAdmin() || isProjectOwner(projectId);
      allow write, delete: if isAdmin();
    }
  }
}
