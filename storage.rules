rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return isSignedIn() && myRole() in ['owner', 'manager'];
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Arquivos de projetos (consultora e cliente)
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isStaff() || isProjectOwner(projectId);
      allow write: if isStaff() || isProjectOwner(projectId);
      allow delete: if isStaff();
    }

    // Logos de branding (por projeto)
    match /branding/{projectId}/{allPaths=**} {
      allow read: if isStaff() || isProjectOwner(projectId);
      allow write, delete: if isStaff();
    }

    // Logos de branding padrão do cliente
    match /clients/{clientId}/{allPaths=**} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == clientId);
      allow write, delete: if isStaff();
    }
  }
}
