rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myAccount() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isSignedIn() && myAccount().role == 'owner';
    }

    function isManager() {
      return isSignedIn() && myAccount().role == 'manager';
    }

    function isStaff() {
      return isOwner() || isManager();
    }

    function managerCanAccessProject(projectId) {
      let acc = myAccount();
      return !('projectAccess' in acc) || acc.projectAccess == null || (projectId in acc.projectAccess);
    }

    function canAccessProject(projectId) {
      return isOwner() || (isManager() && managerCanAccessProject(projectId));
    }

    function myCompanyId() {
      return isSignedIn() ? myAccount().get('companyId', null) : null;
    }

    // Um cliente pode ser o dono direto do projeto (ownerId == seu uid) ou um
    // colaborador de uma empresa-cliente (seu companyId == ownerId do projeto).
    function isProjectOwner(projectId) {
      let ownerId = firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId;
      return isSignedIn() && (ownerId == request.auth.uid || ownerId == myCompanyId());
    }

    // Arquivos de projetos (consultora e cliente)
    match /projects/{projectId}/{allPaths=**} {
      allow read: if canAccessProject(projectId) || isProjectOwner(projectId);
      allow write: if canAccessProject(projectId) || isProjectOwner(projectId);
      allow delete: if canAccessProject(projectId);
    }

    // Logos de branding (por projeto)
    match /branding/{projectId}/{allPaths=**} {
      allow read: if canAccessProject(projectId) || isProjectOwner(projectId);
      allow write, delete: if canAccessProject(projectId);
    }

    // Logos de branding e foto padrão do cliente (não é restrito por
    // projeto) — colaboradores da mesma empresa também podem ler.
    match /clients/{clientId}/{allPaths=**} {
      allow read: if isStaff() || (isSignedIn() && (request.auth.uid == clientId || myCompanyId() == clientId));
      allow write, delete: if isStaff();
    }

    // Anexos de tarefas do quadro Kanban (interno da equipe).
    match /tasks/{taskId}/{allPaths=**} {
      allow read, write, delete: if isStaff();
    }
  }
}
